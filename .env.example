# Supabase — copy to .env.local and fill with your project's values.
# .env.local is git-ignored. NEVER commit real keys or passwords.
# The keys shared during planning are considered compromised — rotate them
# in the Supabase dashboard (Settings → API) before use.

# Client-safe (RLS-guarded), used by the browser and server request clients:
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Public site origin — the single source of truth for absolute URLs: the member
# QR target (/admin/members/<id>) and the auth email redirects (must be allow-listed
# in Supabase Auth → URL Configuration). Set it in .env.local. No trailing slash.
# e.g. http://localhost:3000 for dev, https://meska-classroom.vercel.app for prod.
NEXT_PUBLIC_SITE_URL=https://meska-classroom.vercel.app

# Server-only — used solely by scripts/seed-admin.ts. Never import into request/client code:
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SEED_ADMIN_PASSWORD=choose-a-strong-admin-password
